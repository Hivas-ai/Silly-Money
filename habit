// --- LOADER ---
window.addEventListener('load', () => {
    loadState();
    initLoader();
});

function initLoader() {
    const steps = [
        { pct: 0, status: 'Initializing...' },
        { pct: 30, status: 'Loading assets...' },
        { pct: 60, status: 'Preparing world...' },
        { pct: 85, status: 'Loading pets...' },
        { pct: 100, status: 'Entering HabitQuest!' }
    ];
    
    let step = 0;
    
    function update() {
        if (step >= steps.length) {
            setTimeout(() => {
                document.getElementById('loader').style.opacity = '0';
                setTimeout(() => {
                    document.getElementById('loader').style.display = 'none';
                    document.getElementById('app').classList.add('loaded');
                    initApp();
                }, 300);
            }, 500);
            return;
        }
        
        const s = steps[step];
        document.getElementById('loaderBar').style.width = s.pct + '%';
        document.getElementById('loaderPercent').textContent = s.pct + '%';
        document.getElementById('loaderStatus').textContent = s.status;
        
        step++;
        setTimeout(update, step === 1 ? 800 : 600);
    }
    
    update();
}

function initApp() {
    applyTheme();
    initIconPicker();
    checkDailyReset();
    initWheel();
    startBoostTimer();
    updateUI();
    renderAll();
    startEnergyRegen();
}

// --- CORE FUNCTIONS ---

function initIconPicker() {
    const container = document.getElementById('iconPicker');
    container.innerHTML = ICONS.map((icon, i) => `
        <div class="icon-option ${i === 0 ? 'selected' : ''}" data-icon="${icon}" onclick="selectIcon(this)">
            <i class="fas ${icon}"></i>
        </div>
    `).join('');
}

function selectIcon(el) {
    document.querySelectorAll('.icon-option').forEach(e => e.classList.remove('selected'));
    el.classList.add('selected');
}

function addHabit() {
    const name = document.getElementById('habitNameInput').value.trim();
    if (!name) return showToast('Enter a quest name!', 'error');

    const selected = document.querySelector('.icon-option.selected');
    const icon = selected ? selected.dataset.icon : ICONS[0];

    state.habits.push({
        id: Date.now(),
        name,
        icon,
        streak: 0,
        total: 0,
        created: Date.now()
    });

    saveState();
    renderHabits();
    closeAddModal();
    showToast('Quest created! +10 XP', 'success');
    addXP(10);
    checkAchievement('first_habit');
}

function toggleHabit(id) {
    const today = new Date().toDateString();
    if (!state.completions[today]) state.completions[today] = {};

    if (state.completions[today][id]) {
        delete state.completions[today][id];
        const habit = state.habits.find(h => h.id === id);
        if (habit) habit.total = Math.max(0, habit.total - 1);
    } else {
        if (state.energy < 5) return showToast('Not enough energy!', 'error');
        
        state.energy -= 5;
        state.completions[today][id] = true;
        
        const habit = state.habits.find(h => h.id === id);
        habit.total++;
        habit.streak++;
        
        // Apply boost multipliers
        const xpReward = Math.floor(15 * state.activeBoosts.xp.multiplier);
        const coinReward = Math.floor(10 * state.activeBoosts.coins.multiplier);
        
        addXP(xpReward);
        state.coins += coinReward;
        
        showFloatingText(event, `+${xpReward} XP +${coinReward}🪙`);
        showToast('Quest completed!', 'success');
        
        state.pet.happiness = Math.min(100, state.pet.happiness + 5);
        createConfetti(10);
    }

    saveState();
    updateUI();
    renderHabits();
    updateChart();
}

function addXP(amount) {
    const boostedAmount = Math.floor(amount * state.activeBoosts.xp.multiplier);
    state.xp += boostedAmount;
    state.totalXP += boostedAmount;
    const needed = getXPForLevel(state.level);
    
    if (state.xp >= needed) {
        state.xp -= needed;
        levelUp();
    }
    updateUI();
}

function getXPForLevel(lvl) {
    return Math.floor(100 * Math.pow(1.3, lvl - 1));
}

function levelUp() {
    state.level++;
    createConfetti(50);
    showResult('LEVEL UP!', `You are now level ${state.level}!`, '🎉', 'Continue');
    renderJourneyMap();
    checkAchievement('level_5');
}

