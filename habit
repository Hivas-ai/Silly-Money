    setTimeout(() => plus.remove(), 800);
}

function updateClickerDisplay() {
    document.getElementById('clickerScore').textContent = clickerScore;
    document.getElementById('clickerTimer').textContent = clickerTime.toFixed(1) + 's';
    
    const timer = document.getElementById('clickerTimer');
    if (clickerTime <= 3) timer.classList.add('warning');
    else timer.classList.remove('warning');
}

function endClicker() {
    clearInterval(clickerInterval);
    document.getElementById('clickerTarget').style.pointerEvents = 'none';
    
    const reward = Math.min(100, clickerScore);
    const boostedReward = Math.floor(reward * state.activeBoosts.coins.multiplier);
    state.coins += boostedReward;
    addXP(Math.floor(reward / 3));
    
    if (clickerScore > state.gameStats.clickerBest) {
        state.gameStats.clickerBest = clickerScore;
    }
    
    saveState();
    updateUI();
    
    setTimeout(() => {
        closeClicker();
        showResult('Game Over!', `You earned ${boostedReward} coins!`, '🏆', 'Awesome!');
    }, 500);
}

function closeClicker() {
    clearInterval(clickerInterval);
    document.getElementById('clickerModal').classList.remove('active');
}

// MEMORY GAME
function startMemory() {
    document.getElementById('memoryModal').classList.add('active');
    document.getElementById('memoryStartBtn').style.display = 'block';
    document.getElementById('memoryGrid').innerHTML = '';
    memoryMoves = 0;
    memoryMatches = 0;
    memoryTime = 0;
    memoryFlipped = [];
    updateMemoryDisplay();
}

function startMemoryGame() {
    if (state.energy < 15) {
        showToast('Need 15 energy!', 'error');
        return;
    }
    
    state.energy -= 15;
    updateUI();
    
    document.getElementById('memoryStartBtn').style.display = 'none';
    
    const emojis = ['🎮', '🎲', '🎯', '🎪', '🎨', '🎭'];
    const cards = [...emojis, ...emojis].sort(() => Math.random() - 0.5);
    memoryCards = cards;
    
    const grid = document.getElementById('memoryGrid');
    grid.innerHTML = cards.map((emoji, i) => `
        <div class="memory-card" data-index="${i}" data-emoji="${emoji}" onclick="flipCard(${i})">
            <span style="opacity: 0;">${emoji}</span>
        </div>
    `).join('');
    
    memoryInterval = setInterval(() => {
        memoryTime++;
        updateMemoryDisplay();
    }, 1000);
}

function flipCard(index) {
    const card = document.querySelector(`.memory-card[data-index="${index}"]`);
    if (!card || card.classList.contains('flipped') || card.classList.contains('matched') || memoryFlipped.length >= 2) return;
    
    card.classList.add('flipped');
    card.querySelector('span').style.opacity = '1';
    memoryFlipped.push({ index, emoji: memoryCards[index] });
    
    if (memoryFlipped.length === 2) {
        memoryMoves++;
        updateMemoryDisplay();
        
        const [first, second] = memoryFlipped;
        if (first.emoji === second.emoji) {
            setTimeout(() => {
                document.querySelector(`.memory-card[data-index="${first.index}"]`).classList.add('matched');
                document.querySelector(`.memory-card[data-index="${second.index}"]`).classList.add('matched');
                memoryMatches++;
                memoryFlipped = [];
                updateMemoryDisplay();
                
                if (memoryMatches === 6) {
                    endMemory();
                }
            }, 500);
        } else {
            setTimeout(() => {
                document.querySelector(`.memory-card[data-index="${first.index}"]`).classList.remove('flipped');
                document.querySelector(`.memory-card[data-index="${first.index}"]`).querySelector('span').style.opacity = '0';
                document.querySelector(`.memory-card[data-index="${second.index}"]`).classList.remove('flipped');
                document.querySelector(`.memory-card[data-index="${second.index}"]`).querySelector('span').style.opacity = '0';
                memoryFlipped = [];
            }, 1000);
        }
    }
}

function updateMemoryDisplay() {
    document.getElementById('memoryMoves').textContent = memoryMoves;
    document.getElementById('memoryMatches').textContent = memoryMatches;
    document.getElementById('memoryTime').textContent = memoryTime + 's';
}

function endMemory() {
    clearInterval(memoryInterval);
    
    const baseReward = 3;
    const timeBonus = Math.max(0, 5 - Math.floor(memoryTime / 30));
    const moveBonus = Math.max(0, 3 - Math.floor(memoryMoves / 6));
    const totalGems = baseReward + timeBonus + moveBonus;
    
    state.gems += totalGems;
    addXP(50);
    
    if (memoryTime < state.gameStats.memoryBest || state.gameStats.memoryBest === 0) {
        state.gameStats.memoryBest = memoryTime;
    }
    
    saveState();
    updateUI();
    
    setTimeout(() => {
        closeMemory();
        showResult('Victory!', `Perfect! You earned ${totalGems} gems!`, '💎', 'Excellent!');
    }, 500);
}

function closeMemory() {
    clearInterval(memoryInterval);
    document.getElementById('memoryModal').classList.remove('active');
}

// SPIN GAME
function initWheel() {
    const wheel = document.getElementById('wheel');
    const segmentAngle = 360 / WHEEL_REWARDS.length;
    
    wheel.innerHTML = WHEEL_REWARDS.map((reward, i) => {
        const rotation = i * segmentAngle;
        return `
            <div class="wheel-segment" style="
                transform: rotate(${rotation}deg);
                background: ${reward.color};
                clip-path: polygon(100% 0, 100% 100%, 0 100%);
            ">
                <span>${reward.icon} ${reward.value}</span>
            </div>
        `;
    }).join('');
}

function startSpin() {
    document.getElementById('spinModal').classList.add('active');
}

function doSpin() {
    if (isSpinning) return;
    if (state.energy < 5) {
        showToast('Need 5 energy!', 'error');
        return;
    }
    
    state.energy -= 5;
    updateUI();
    
    isSpinning = true;
    const btn = document.getElementById('spinBtn');
    btn.disabled = true;
    btn.classList.add('spinning');
    
    const wheel = document.getElementById('wheel');
    const randomIndex = Math.floor(Math.random() * WHEEL_REWARDS.length);
    const segmentAngle = 360 / WHEEL_REWARDS.length;
    const extraSpins = 5 + Math.floor(Math.random() * 3);
    const finalRotation = 360 * extraSpins + (randomIndex * segmentAngle) + (segmentAngle / 2);
    
    wheel.style.transform = `rotate(${finalRotation}deg)`;
    
    setTimeout(() => {
        const reward = WHEEL_REWARDS[randomIndex];
        applyReward(reward);
        
        isSpinning = false;
        btn.disabled = false;
        btn.classList.remove('spinning');
    }, 4000);
}

function applyReward(reward) {
    let amount = reward.value;
    
    if (reward.type === 'coins') {
        amount = Math.floor(amount * state.activeBoosts.coins.multiplier);
        state.coins += amount;
    } else {
        state.gems += amount;
    }
    
    saveState();
    updateUI();
    
    const typeText = reward.type === 'coins' ? 'coins' : 'gems';
    const icon = reward.type === 'coins' ? '🪙' : '💎';
    
    setTimeout(() => {
        closeSpin();
        showResult('You Won!', `${icon} ${amount} ${typeText}!`, icon, 'Great!');
    }, 300);
}

function closeSpin() {
    document.getElementById('spinModal').classList.remove('active');
}

