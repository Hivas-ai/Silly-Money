function feedPet() {
    if (state.coins < 10) return showToast('Need 10 coins!', 'error');
    if (state.pet.hunger >= 100) return showToast('Pet is full!', 'info');
    
    state.coins -= 10;
    state.pet.hunger = Math.min(100, state.pet.hunger + 30);
    state.pet.xp += 10;
    
    if (state.pet.xp >= state.pet.level * 50) {
        state.pet.level++;
        state.pet.xp = 0;
        showToast('Pet leveled up!', 'success');
    }
    
    saveState();
    updateUI();
