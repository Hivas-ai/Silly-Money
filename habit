// CLICKER GAME
function startClicker() {
    document.getElementById('clickerModal').classList.add('active');
    document.getElementById('clickerStartBtn').style.display = 'block';
    document.getElementById('clickerTarget').style.pointerEvents = 'none';
    clickerScore = 0;
    clickerTime = 10;
    updateClickerDisplay();
}

function startClickerGame() {
    if (state.energy < 10) {
        showToast('Need 10 energy!', 'error');
        return;
    }
    
    state.energy -= 10;
    updateUI();
    
    document.getElementById('clickerStartBtn').style.display = 'none';
    document.getElementById('clickerTarget').style.pointerEvents = 'auto';
    
    clickerInterval = setInterval(() => {
        clickerTime -= 0.1;
        if (clickerTime <= 0) {
            clickerTime = 0;
            endClicker();
        }
        updateClickerDisplay();
    }, 100);
}

function doClick(e) {
    clickerScore++;
    updateClickerDisplay();
    
    const target = document.getElementById('clickerTarget');
    target.style.transform = 'scale(0.9)';
    setTimeout(() => target.style.transform = 'scale(1)', 50);
    
    const plus = document.createElement('div');
    plus.className = 'float-text';
    plus.textContent = '+1';
    plus.style.left = (e.clientX - 20) + 'px';
    plus.style.top = (e.clientY - 40) + 'px';
    plus.style.color = 'var(--warning)';
