<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>HabitQuest RPG | Complete Experience</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&family=Orbitron:wght@700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg: #f8fafc;
            --surface: #ffffff;
            --surface-hover: #f1f5f9;
            --text: #0f172a;
            --text-muted: #64748b;
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --primary-soft: rgba(99, 102, 241, 0.1);
            --secondary: #ec4899;
            --accent: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --info: #0ea5e9;
            --purple: #8b5cf6;
            --orange: #f97316;
            --border: #e2e8f0;
            --shadow: 0 4px 20px rgba(0,0,0,0.08);
            --shadow-lg: 0 10px 40px rgba(0,0,0,0.12);
            --radius: 20px;
            --radius-sm: 12px;
            --font-display: 'Orbitron', sans-serif;
        }

        [data-theme="dark"] {
            --bg: #020617;
            --surface: #0f172a;
            --surface-hover: #1e293b;
            --text: #f8fafc;
            --text-muted: #94a3b8;
            --primary: #818cf8;
            --primary-dark: #6366f1;
            --primary-soft: rgba(129, 140, 248, 0.15);
            --border: #334155;
            --shadow: 0 4px 20px rgba(0,0,0,0.4);
            --shadow-lg: 0 10px 40px rgba(0,0,0,0.5);
        }

        [data-theme="forest"] {
            --bg: #022c22;
            --surface: #064e3b;
            --surface-hover: #065f46;
            --text: #ecfdf5;
            --text-muted: #6ee7b7;
            --primary: #34d399;
            --primary-dark: #10b981;
            --primary-soft: rgba(52, 211, 153, 0.15);
            --border: #047857;
            --shadow: 0 4px 20px rgba(0,0,0,0.5);
            --shadow-lg: 0 10px 40px rgba(0,0,0,0.6);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            min-height: 100vh;
            overflow-x: hidden;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        /* LOADER */
        .loader-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--purple) 100%);
            z-index: 100000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: white;
        }

        .loader-content {
            text-align: center;
            max-width: 300px;
            width: 90%;
        }

        .loader-logo {
            font-family: var(--font-display);
            font-size: 3rem;
            margin-bottom: 10px;
            animation: pulse 2s infinite;
        }

        .loader-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 40px;
            opacity: 0.9;
        }

        .loader-bar-container {
            width: 100%;
            margin-bottom: 20px;
        }

        .loader-bar-bg {
            height: 12px;
            background: rgba(255,255,255,0.2);
            border-radius: 10px;
            overflow: hidden;
            position: relative;
        }

        .loader-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #60a5fa, #ffffff, #60a5fa);
            background-size: 200% 100%;
            width: 0%;
            border-radius: 10px;
            transition: width 0.3s ease;
            animation: shimmer 2s infinite;
        }

        @keyframes shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }

        .loader-percent {
            font-family: var(--font-display);
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .loader-status {
            font-size: 0.9rem;
            opacity: 0.8;
            height: 20px;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.05); opacity: 0.8; }
        }

        /* Main App */
        .app-container {
            max-width: 480px;
            margin: 0 auto;
            min-height: 100vh;
            position: relative;
            padding-bottom: 100px;
            display: none;
        }

        .app-container.loaded {
            display: block;
            animation: fadeIn 0.5s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Header */
        .app-header {
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            background: rgba(var(--bg), 0.9);
            backdrop-filter: blur(20px);
            z-index: 100;
            border-bottom: 1px solid var(--border);
        }

        .logo {
            font-family: var(--font-display);
            font-weight: 900;
            font-size: 1.4rem;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--primary);
        }

        .header-actions {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .header-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
        }

        .header-btn:hover {
            border-color: var(--primary);
            transform: scale(1.05);
        }

        .level-badge {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* Hero Stats */
        .hero-bar {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            padding: 20px;
        }

        .stat-card {
            background: var(--surface);
            border-radius: var(--radius-sm);
            padding: 16px;
            text-align: center;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            transition: transform 0.2s;
        }

        .stat-card:hover {
            transform: translateY(-2px);
        }

        .stat-value {
            font-family: var(--font-display);
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .stat-card.coins .stat-value { color: var(--warning); }
        .stat-card.gems .stat-value { color: var(--secondary); }
        .stat-card.energy .stat-value { color: var(--info); }

        .stat-label {
            font-size: 0.7rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Bars */
        .bar-container {
            padding: 0 20px;
            margin-bottom: 20px;
        }

        .bar-bg {
            height: 10px;
            background: var(--surface);
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid var(--border);
        }

        .bar-fill {
            height: 100%;
            border-radius: 10px;
            transition: width 0.5s ease;
        }

        .xp-fill {
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            animation: gradient-shift 3s ease infinite;
            background-size: 200% 100%;
        }

        .energy-fill {
            background: linear-gradient(90deg, var(--info), var(--accent));
        }

        @keyframes gradient-shift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .bar-text {
            display: flex;
            justify-content: space-between;
            margin-top: 6px;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        /* Daily Reward */
        .daily-reward {
            margin: 0 20px 20px;
            background: linear-gradient(135deg, var(--warning), var(--orange));
            border-radius: var(--radius);
            padding: 20px;
            color: white;
            position: relative;
            overflow: hidden;
            transition: transform 0.2s;
        }

        .daily-reward:hover {
            transform: translateY(-2px);
        }

        .daily-reward::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 200px;
            height: 200px;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
        }

        .daily-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
            position: relative;
            z-index: 1;
        }

        .daily-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .claim-btn {
            width: 100%;
            padding: 14px;
            background: white;
            color: var(--orange);
            border: none;
            border-radius: 12px;
            font-weight: 700;
            cursor: pointer;
            position: relative;
            z-index: 1;
            transition: all 0.2s;
        }

        .claim-btn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

        .claim-btn:not(:disabled):hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
        }

        /* Section Headers */
        .section-header {
            padding: 0 20px;
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .section-title i {
            color: var(--primary);
        }

        .section-action {
            font-size: 0.85rem;
            color: var(--primary);
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .add-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--primary);
            color: white;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
            transition: transform 0.2s;
        }

        .add-btn:active {
            transform: scale(0.9);
        }

        /* Journey Map */
        .journey-section {
            margin-bottom: 25px;
        }

        .map-container {
            position: relative;
            padding: 30px 20px;
            margin: 0 20px;
            background: var(--surface);
            border-radius: var(--radius);
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .map-bg {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            opacity: 0.05;
            background-image: 
                radial-gradient(circle at 20% 50%, var(--primary) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, var(--secondary) 0%, transparent 50%);
        }

        .map-path {
            position: relative;
            height: 120px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .path-line {
            position: absolute;
            top: 50%;
            left: 10%;
            right: 10%;
            height: 4px;
            background: var(--border);
            border-radius: 2px;
            transform: translateY(-50%);
        }

        .path-progress {
            height: 100%;
            background: linear-gradient(90deg, var(--primary), var(--accent));
            border-radius: 2px;
            transition: width 0.5s ease;
        }

        .map-node {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: transform 0.3s;
        }

        .map-node:hover {
            transform: scale(1.1);
        }

        .node-orb {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            border: 3px solid transparent;
            transition: all 0.3s;
            background: var(--bg);
        }

        .map-node.completed .node-orb {
            background: var(--accent);
            color: white;
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.4);
        }

        .map-node.current .node-orb {
            background: var(--primary);
            color: white;
            box-shadow: 0 0 30px var(--primary);
            animation: pulse-glow 2s infinite;
        }

        .map-node.locked .node-orb {
            background: var(--surface-hover);
            color: var(--text-muted);
            border-color: var(--border);
        }

        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 20px var(--primary); }
            50% { box-shadow: 0 0 40px var(--primary); }
        }

        .node-label {
            font-size: 0.7rem;
            font-weight: 600;
            text-align: center;
            max-width: 70px;
            background: var(--surface);
            padding: 4px 8px;
            border-radius: 20px;
            border: 1px solid var(--border);
        }

        .map-node.current .node-label {
            color: var(--primary);
            border-color: var(--primary);
        }

        /* Mission Card */
        .mission-card {
            margin: 0 20px 25px;
            background: var(--surface);
            border-radius: var(--radius);
            padding: 25px;
            border: 2px solid var(--primary);
            box-shadow: 0 0 30px var(--primary-soft);
        }

        .mission-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .mission-icon {
            width: 60px;
            height: 60px;
            border-radius: var(--radius-sm);
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: white;
        }

        .mission-info h3 {
            font-size: 1.2rem;
            margin-bottom: 4px;
        }

        .mission-info p {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .mission-progress {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .mission-progress-bar {
            flex: 1;
            height: 8px;
            background: var(--bg);
            border-radius: 10px;
            overflow: hidden;
        }

        .mission-progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--primary), var(--accent));
            border-radius: 10px;
            transition: width 0.3s;
        }

        .mission-progress-text {
            font-family: var(--font-display);
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--primary);
        }

        .mission-tasks {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .mission-task {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px;
            background: var(--bg);
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.2s;
            border: 1px solid transparent;
        }

        .mission-task:hover {
            border-color: var(--primary);
            transform: translateX(5px);
        }

        .mission-task.completed {
            opacity: 0.6;
            border-color: var(--accent);
        }

        .mission-task.completed .task-text {
            text-decoration: line-through;
        }

        .task-check {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            border: 2px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            color: transparent;
            transition: all 0.2s;
            flex-shrink: 0;
        }

        .mission-task.completed .task-check {
            background: var(--accent);
            border-color: var(--accent);
            color: white;
        }

        .task-reward {
            margin-left: auto;
            font-size: 0.75rem;
            color: var(--warning);
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* Pet */
        .pet-card {
            margin: 0 20px 25px;
            background: var(--surface);
            border-radius: var(--radius);
            padding: 25px;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 20px;
            transition: transform 0.2s;
        }

        .pet-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow);
        }

        .pet-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-soft), var(--secondary));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            position: relative;
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .pet-status {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            color: white;
            border: 3px solid var(--surface);
        }

        .pet-info {
            flex: 1;
        }

        .pet-info h3 {
            font-size: 1.2rem;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .pet-level {
            background: var(--primary);
            color: white;
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
        }

        .pet-stats {
            display: flex;
            gap: 15px;
            margin-bottom: 15px;
        }

        .pet-stat {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .pet-bar {
            width: 60px;
            height: 6px;
            background: var(--bg);
            border-radius: 10px;
            overflow: hidden;
            margin-left: 4px;
        }

        .pet-bar-fill {
            height: 100%;
            border-radius: 10px;
            transition: width 0.3s;
        }

        .pet-bar-fill.happiness { background: var(--secondary); }
        .pet-bar-fill.hunger { background: var(--warning); }

        .pet-actions {
            display: flex;
            gap: 10px;
        }

        .pet-btn {
            padding: 10px 18px;
            border-radius: 20px;
            border: none;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .pet-btn.feed {
            background: var(--warning);
            color: white;
        }

        .pet-btn.play {
            background: var(--primary);
            color: white;
        }

        .pet-btn:hover:not(:disabled) {
            transform: scale(1.05);
        }

        .pet-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* Games */
        .games-section {
            margin-bottom: 25px;
        }

        .games-scroll {
            display: flex;
            gap: 15px;
            padding: 0 20px;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .games-scroll::-webkit-scrollbar { display: none; }

        .game-card {
            min-width: 150px;
            background: var(--surface);
            border-radius: var(--radius-sm);
            padding: 20px;
            text-align: center;
            border: 1px solid var(--border);
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
        }

        .game-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
            border-color: var(--primary);
        }

        .game-cost {
            position: absolute;
            top: 10px;
            right: 10px;
            background: var(--bg);
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--info);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .game-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            margin: 0 auto 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: white;
        }

        .game-card:nth-child(1) .game-icon { background: linear-gradient(135deg, #f093fb, #f5576c); }
        .game-card:nth-child(2) .game-icon { background: linear-gradient(135deg, #4facfe, #00f2fe); }
        .game-card:nth-child(3) .game-icon { background: linear-gradient(135deg, #43e97b, #38f9d7); }

        .game-name {
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 8px;
        }

        .game-reward {
            font-size: 0.8rem;
            color: var(--warning);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        /* Habits */
        .habits-section {
            margin-bottom: 25px;
        }

        .habit-card {
            margin: 0 20px 12px;
            background: var(--surface);
            border-radius: var(--radius-sm);
            padding: 18px;
            display: flex;
            align-items: center;
            gap: 15px;
            border: 1px solid var(--border);
            transition: all 0.3s;
            cursor: pointer;
        }

        .habit-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow);
        }

        .habit-card.completed {
            border-color: var(--accent);
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, var(--surface) 100%);
        }

        .habit-icon-wrapper {
            position: relative;
        }

        .habit-icon {
            width: 50px;
            height: 50px;
            border-radius: var(--radius-sm);
            background: var(--primary-soft);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            transition: all 0.3s;
        }

        .habit-card.completed .habit-icon {
            background: var(--accent);
            color: white;
            transform: rotate(360deg);
        }

        .habit-streak-badge {
            position: absolute;
            bottom: -5px;
            right: -5px;
            background: var(--warning);
            color: white;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            font-weight: 700;
            border: 2px solid var(--surface);
        }

        .habit-info {
            flex: 1;
        }

        .habit-title {
            font-weight: 600;
            font-size: 1rem;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .habit-chain {
            display: flex;
            gap: 4px;
        }

        .chain-link {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--border);
            transition: all 0.3s;
        }

        .chain-link.active {
            background: var(--accent);
            box-shadow: 0 0 8px var(--accent);
        }

        .habit-meta {
            font-size: 0.8rem;
            color: var(--text-muted);
            display: flex;
            gap: 15px;
            margin-top: 6px;
        }

        .habit-reward {
            display: flex;
            align-items: center;
            gap: 4px;
            color: var(--warning);
            font-weight: 600;
            font-size: 0.85rem;
        }

        .habit-check {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 2px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: transparent;
            transition: all 0.3s;
            flex-shrink: 0;
        }

        .habit-card.completed .habit-check {
            background: var(--accent);
            border-color: var(--accent);
            color: white;
            transform: scale(1.1);
        }

        /* Analytics */
        .analytics-card {
            margin: 0 20px 25px;
            background: var(--surface);
            border-radius: var(--radius);
            padding: 25px;
            border: 1px solid var(--border);
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .chart-tabs {
            display: flex;
            gap: 8px;
        }

        .chart-tab {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            background: var(--bg);
            color: var(--text-muted);
            border: 1px solid var(--border);
            transition: all 0.2s;
        }

        .chart-tab.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .chart-container {
            height: 200px;
            margin-bottom: 20px;
        }

        .stats-detailed {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .detailed-stat {
            background: var(--bg);
            border-radius: var(--radius-sm);
            padding: 20px;
            text-align: center;
            border: 1px solid var(--border);
            transition: all 0.2s;
        }

        .detailed-stat:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        .detailed-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            margin: 0 auto 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .detailed-icon.purple { background: var(--primary-soft); color: var(--primary); }
        .detailed-icon.green { background: rgba(16, 185, 129, 0.1); color: var(--accent); }
        .detailed-icon.orange { background: rgba(245, 158, 11, 0.1); color: var(--warning); }
        .detailed-icon.blue { background: rgba(14, 165, 233, 0.1); color: var(--info); }

        .detailed-value {
            font-family: var(--font-display);
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 4px;
        }

        .detailed-label {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        /* Bottom Nav */
        .bottom-nav {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: calc(100% - 40px);
            max-width: 440px;
            background: var(--surface);
            display: flex;
            justify-content: space-around;
            padding: 15px;
            z-index: 1000;
            border-radius: 30px;
            box-shadow: var(--shadow-lg), 0 0 0 1px var(--border);
            border: 1px solid var(--border);
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.7rem;
            font-weight: 600;
            transition: all 0.3s;
            width: 60px;
            border: none;
            background: none;
            cursor: pointer;
            padding: 8px;
            border-radius: 20px;
        }

        .nav-item i {
            font-size: 1.4rem;
            transition: all 0.3s;
        }

        .nav-item.active {
            color: var(--primary);
            background: var(--primary-soft);
        }

        .nav-item.active i {
            transform: scale(1.1);
        }

        .nav-item.middle {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            margin-top: -30px;
            box-shadow: 0 10px 30px rgba(99, 102, 241, 0.4);
        }

        .nav-item.middle i {
            font-size: 1.6rem;
        }

        /* Modals */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.85);
            z-index: 2000;
            align-items: center;
            justify-content: center;
            padding: 20px;
            backdrop-filter: blur(10px);
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-content {
            background: var(--surface);
            border-radius: var(--radius);
            width: 100%;
            max-width: 420px;
            max-height: 90vh;
            overflow-y: auto;
            animation: modalUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            border: 1px solid var(--border);
        }

        @keyframes modalUp {
            from { transform: translateY(100px) scale(0.9); opacity: 0; }
            to { transform: translateY(0) scale(1); opacity: 1; }
        }

        .modal-header {
            padding: 25px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(135deg, var(--surface) 0%, var(--surface-hover) 100%);
        }

        .modal-title {
            font-size: 1.3rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .modal-close {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: none;
            background: var(--bg);
            color: var(--text-muted);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            transition: all 0.2s;
        }

        .modal-close:hover {
            background: var(--border);
            color: var(--text);
            transform: rotate(90deg);
        }

        .modal-body {
            padding: 25px;
        }

        /* Game Modals */
        .game-area {
            min-height: 400px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        /* Clicker Game */
        .clicker-game {
            text-align: center;
        }

        .clicker-target {
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--warning), var(--orange));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 5rem;
            color: white;
            cursor: pointer;
            margin: 30px auto;
            box-shadow: 0 15px 40px rgba(245, 158, 11, 0.4);
            transition: transform 0.1s;
            user-select: none;
            position: relative;
        }

        .clicker-target:active {
            transform: scale(0.95);
        }

        .clicker-target::after {
            content: '';
            position: absolute;
            inset: -10px;
            border-radius: 50%;
            border: 3px solid var(--warning);
            opacity: 0;
            animation: ripple 1s infinite;
        }

        @keyframes ripple {
            0% { transform: scale(1); opacity: 0.5; }
            100% { transform: scale(1.2); opacity: 0; }
        }

        .clicker-score {
            font-family: var(--font-display);
            font-size: 4rem;
            font-weight: 700;
            color: var(--text);
            margin: 20px 0;
        }

        .clicker-timer {
            font-size: 1.5rem;
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        .clicker-timer.warning {
            color: var(--danger);
            animation: pulse 0.5s infinite;
        }

        /* Memory Game */
        .memory-game {
            width: 100%;
        }

        .memory-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin: 20px 0;
        }

        .memory-card {
            aspect-ratio: 1;
            background: var(--bg);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            cursor: pointer;
            transition: all 0.3s;
            border: 2px solid var(--border);
        }

        .memory-card:hover:not(.flipped):not(.matched) {
            border-color: var(--primary);
            transform: scale(1.05);
        }

        .memory-card.flipped {
            background: var(--primary);
            color: white;
            transform: rotateY(180deg);
        }

        .memory-card.matched {
            background: var(--accent);
            color: white;
            animation: matchPulse 0.5s;
        }

        @keyframes matchPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .memory-stats {
            display: flex;
            justify-content: space-around;
            margin-bottom: 20px;
        }

        .memory-stat {
            text-align: center;
        }

        .memory-stat-value {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary);
        }

        .memory-stat-label {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        /* Spin Game */
        .spin-game {
            text-align: center;
        }

        .wheel-container {
            position: relative;
            width: 280px;
            height: 280px;
            margin: 30px auto;
        }

        .wheel {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            border: 4px solid var(--border);
            transition: transform 4s cubic-bezier(0.17, 0.67, 0.12, 0.99);
        }

        .wheel-segment {
            position: absolute;
            width: 50%;
            height: 50%;
            transform-origin: right bottom;
            left: 0;
            top: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.9rem;
            color: white;
            text-shadow: 0 2px 4px rgba(0,0,0,0.4);
        }

        .wheel-segment span {
            transform: rotate(22.5deg) translateX(-30px);
            display: block;
        }

        .wheel-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 60px;
            height: 60px;
            background: var(--surface);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            z-index: 10;
            border: 3px solid var(--warning);
        }

        .wheel-center i {
            font-size: 1.5rem;
            color: var(--warning);
        }

        .wheel-pointer {
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            width: 30px;
            height: 40px;
            background: linear-gradient(135deg, var(--danger), #dc2626);
            clip-path: polygon(50% 100%, 0 0, 100% 0);
            z-index: 20;
            filter: drop-shadow(0 4px 6px rgba(0,0,0,0.3));
        }

        .spin-btn {
            padding: 18px 50px;
            background: linear-gradient(135deg, var(--warning), var(--orange));
            color: white;
            border: none;
            border-radius: 30px;
            font-weight: 700;
            font-size: 1.2rem;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 10px 30px rgba(245, 158, 11, 0.3);
        }

        .spin-btn:hover:not(:disabled) {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(245, 158, 11, 0.4);
        }

        .spin-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .spin-btn.spinning {
            animation: btnPulse 0.5s infinite;
        }

        @keyframes btnPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        /* Form Elements */
        .input-group {
            margin-bottom: 20px;
        }

        .input-label {
            display: block;
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .input-field {
            width: 100%;
            padding: 16px;
            background: var(--bg);
            border: 2px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text);
            font-size: 1rem;
            outline: none;
            transition: all 0.2s;
        }

        .input-field:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--primary-soft);
        }

        .icon-picker {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        .icon-option {
            aspect-ratio: 1;
            border-radius: var(--radius-sm);
            background: var(--bg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: var(--text-muted);
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.2s;
        }

        .icon-option:hover {
            background: var(--primary-soft);
            color: var(--primary);
            transform: scale(1.1);
        }

        .icon-option.selected {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
        }

        .btn-primary {
            width: 100%;
            padding: 18px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            border: none;
            border-radius: var(--radius-sm);
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
        }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
        }

        /* Shop Grid */
        .shop-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .shop-item {
            background: var(--bg);
            border-radius: var(--radius-sm);
            padding: 20px;
            text-align: center;
            border: 2px solid transparent;
            transition: all 0.2s;
            cursor: pointer;
        }

        .shop-item:hover:not(.owned):not(.disabled) {
            border-color: var(--primary);
            transform: translateY(-3px);
        }

        .shop-item.owned {
            border-color: var(--accent);
            opacity: 0.8;
            cursor: default;
        }

        .shop-item.disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .shop-item-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            margin: 0 auto 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
        }

        .shop-item-name {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .shop-item-price {
            color: var(--warning);
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .shop-item.owned .shop-item-price {
            color: var(--accent);
        }

        /* Toast */
        .toast-container {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10000;
            display: flex;
            flex-direction: column;
            gap: 10px;
            pointer-events: none;
            width: 90%;
            max-width: 400px;
        }

        .toast {
            background: var(--surface);
            color: var(--text);
            padding: 16px 20px;
            border-radius: var(--radius-sm);
            font-size: 0.95rem;
            font-weight: 600;
            box-shadow: var(--shadow-lg);
            border-left: 4px solid var(--primary);
            display: flex;
            align-items: center;
            gap: 12px;
            animation: toastSlide 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            pointer-events: auto;
            border: 1px solid var(--border);
        }

        @keyframes toastSlide {
            from { transform: translateX(-50%) translateY(-30px); opacity: 0; }
            to { transform: translateX(-50%) translateY(0); opacity: 1; }
        }

        .toast.success { border-left-color: var(--accent); }
        .toast.error { border-left-color: var(--danger); }
        .toast.warning { border-left-color: var(--warning); }

        /* Floating Text */
        .float-text {
            position: fixed;
            pointer-events: none;
            font-weight: 800;
            font-size: 1.5rem;
            z-index: 5000;
            animation: floatUp 1s ease-out forwards;
        }

        @keyframes floatUp {
            0% { transform: translateY(0) scale(1); opacity: 1; }
            100% { transform: translateY(-100px) scale(1.5); opacity: 0; }
        }

        /* Confetti */
        .confetti {
            position: fixed;
            width: 12px;
            height: 12px;
            pointer-events: none;
            z-index: 6000;
        }

        @keyframes confetti-fall {
            0% { transform: translateY(-100vh) rotate(0deg); opacity: 1; }
            100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
        }

        /* Result Overlay */
        .result-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.9);
            z-index: 3000;
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            text-align: center;
            padding: 20px;
        }

        .result-overlay.active {
            display: flex;
            animation: fadeIn 0.3s;
        }

        .result-icon {
            font-size: 5rem;
            margin-bottom: 20px;
            animation: bounce 1s infinite;
        }

        .result-title {
            font-family: var(--font-display);
            font-size: 2rem;
            font-weight: 700;
            color: white;
            margin-bottom: 10px;
        }

        .result-amount {
            font-size: 3rem;
            font-weight: 800;
            color: var(--warning);
            margin-bottom: 20px;
        }

        .result-btn {
            padding: 15px 40px;
            background: white;
            color: var(--bg);
            border: none;
            border-radius: 30px;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .result-btn:hover {
            transform: scale(1.05);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
        }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 15px;
            opacity: 0.5;
        }

        /* Leaderboard */
        .leaderboard-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            background: var(--surface);
            border-radius: var(--radius-sm);
            margin-bottom: 12px;
            border: 1px solid var(--border);
            transition: transform 0.2s;
        }

        .leaderboard-item:hover {
            transform: translateX(5px);
        }

        .leaderboard-rank {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-muted);
            width: 40px;
            text-align: center;
        }

        .leaderboard-rank.gold { color: #ffd700; }
        .leaderboard-rank.silver { color: #c0c0c0; }
        .leaderboard-rank.bronze { color: #cd7f32; }

        .leaderboard-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: var(--primary-soft);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .leaderboard-info {
            flex: 1;
        }

        .leaderboard-name {
            font-weight: 600;
            margin-bottom: 4px;
        }

        .leaderboard-level {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .leaderboard-score {
            font-family: var(--font-display);
            font-weight: 700;
            color: var(--primary);
        }

        /* Profile */
        .profile-header {
            padding: 30px 20px;
            text-align: center;
        }

        .profile-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            margin: 0 auto 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 4rem;
            box-shadow: 0 0 40px var(--primary-soft);
        }

        .profile-name {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .profile-title {
            color: var(--text-muted);
            margin-bottom: 25px;
        }

        .profile-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-bottom: 30px;
        }

        .profile-stat {
            background: var(--surface);
            padding: 20px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            transition: transform 0.2s;
        }

        .profile-stat:hover {
            transform: translateY(-3px);
            border-color: var(--primary);
        }

        .profile-stat-value {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .profile-stat-label {
