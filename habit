}

function playWithPet() {
    if (state.energy < 10) return showToast('Need more energy!', 'error');
    
    state.energy -= 10;
    state.pet.happiness = Math.min(100, state.pet.happiness + 15);
    state.pet.xp += 5;
    
    saveState();
    updateUI();
    showToast('Pet had fun! +5 XP', 'success');
}

function changePet(petId) {
    const pet = PETS.find(p => p.id === petId);
