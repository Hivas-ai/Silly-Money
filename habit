// --- BOOST SYSTEM ---

function activateBoost(boostId) {
    const item = SHOP_ITEMS.find(i => i.id === boostId);
    if (!item) return;
    
    if (item.subtype === 'energy') {
        state.energy = state.maxEnergy;
        showToast('Energy refilled!', 'success');
        saveState();
        updateUI();
        return;
    }
    
    const now = Date.now();
    state.activeBoosts[item.subtype] = {
        active: true,
        multiplier: 2,
        expires: now + item.duration
    };
    
    startBoostTimer();
    saveState();
    updateUI();
    showToast(`${item.name} activated for 5 minutes!`, 'success');
}

function startBoostTimer() {
    if (boostInterval) clearInterval(boostInterval);
    
    function update() {
        const now = Date.now();
        let active = false;
        
        ['xp', 'coins'].forEach(type => {
            if (state.activeBoosts[type].active) {
                if (now >= state.activeBoosts[type].expires) {
                    state.activeBoosts[type].active = false;
                    state.activeBoosts[type].multiplier = 1;
                } else {
                    active = true;
                    const remaining = Math.ceil((state.activeBoosts[type].expires - now) / 1000);
                    const mins = Math.floor(remaining / 60);
                    const secs = remaining % 60;
                    
                    const timerEl = document.getElementById('boostTimer');
                    const timeText = document.getElementById('boostTimeLeft');
                    
                    if (state.activeBoosts.xp.active && state.activeBoosts.coins.active) {
                        timeText.textContent = `2x All: ${mins}:${secs.toString().padStart(2, '0')}`;
                    } else if (state.activeBoosts.xp.active) {
                        timeText.textContent = `2x XP: ${mins}:${secs.toString().padStart(2, '0')}`;
                    } else {
                        timeText.textContent = `2x Coins: ${mins}:${secs.toString().padStart(2, '0')}`;
                    }
                    
                    timerEl.classList.add('active');
                }
            }
        });
        
        if (!active) {
            document.getElementById('boostTimer').classList.remove('active');
        }
        
        saveState();
    }
    
    update();
    boostInterval = setInterval(update, 1000);
}

// --- DAILY REWARD ---

function claimDaily() {
    if (state.dailyClaimed) return;
    
    const rewards = { coins: 50, xp: 20, gems: 3 };
    state.coins += rewards.coins;
    state.gems += rewards.gems;
    addXP(rewards.xp);
    
    state.dailyClaimed = true;
    state.lastDaily = new Date().toDateString();
    
    document.getElementById('claimBtn').disabled = true;
    document.getElementById('claimBtn').textContent = 'Claimed!';
    
    showResult('Daily Reward!', `🪙 ${rewards.coins} | XP ${rewards.xp} | 💎 ${rewards.gems}`, '🎁', 'Claimed!');
    saveState();
    updateUI();
}

function checkDailyReset() {
    const today = new Date().toDateString();
    if (state.lastDaily !== today) {
        state.dailyClaimed = false;
    }
    
    const btn = document.getElementById('claimBtn');
    if (state.dailyClaimed) {
        btn.disabled = true;
        btn.textContent = 'Come back tomorrow!';
    } else {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-gift"></i> Claim Now';
    }
    
    if (state.lastLogin !== today) {
        state.lastLogin = today;
        checkStreak();
    }
}

function checkStreak() {
    let current = 0;
    const today = new Date();
    
    for (let i = 0; i < 365; i++) {
        const d = new Date(today);
        d.setDate(d.getDate() - i);
        const ds = d.toDateString();
        
        if (state.completions[ds] && Object.keys(state.completions[ds]).length > 0) {
            current++;
        } else if (i > 0) break;
    }
    
    state.streak = current;
    if (current > state.bestStreak) state.bestStreak = current;
    if (current >= 7) checkAchievement('week_streak');
}

// --- SHOP ---

function openShop(tab = 'themes') {
    currentShopTab = tab;
    switchShopTab(tab);
    document.getElementById('shopModal').classList.add('active');
}

function switchShopTab(tab) {
    currentShopTab = tab;
    
    // Update tabs
    document.querySelectorAll('.shop-tab').forEach(t => t.classList.remove('active'));
    event.target.classList.add('active');
    
    const grid = document.getElementById('shopGrid');
    
    if (tab === 'themes') {
        const themes = SHOP_ITEMS.filter(i => i.type === 'theme');
        grid.innerHTML = themes.map(item => {
            const owned = state.inventory.includes(item.id);
            const canAfford = state[item.currency] >= item.cost;
            const isActive = state.theme === item.id.split('_')[1];
            
            return `
                <div class="shop-item ${owned || isActive ? 'owned' : ''} ${!canAfford && !owned ? 'disabled' : ''}" 
                     onclick="${owned || isActive ? `applyTheme('${item.id.split('_')[1]}')` : `buyItem('${item.id}')`}">
                    <div class="shop-item-icon" style="background: ${item.color}20; color: ${item.color};">
                        ${item.icon}
                    </div>
                    <div class="shop-item-name">${item.name}</div>
                    <div class="shop-item-price">
                        ${isActive ? 'ACTIVE' : owned ? 'OWNED' : `<i class="fas fa-${item.currency === 'gems' ? 'gem' : 'coins'}"></i> ${item.cost}`}
                    </div>
                </div>
            `;
        }).join('');
    } else if (tab === 'pets') {
        grid.innerHTML = PETS.map(pet => {
            const owned = state.inventory.includes(`pet_${pet.id}`) || pet.id === 'dragon';
            const canAfford = state[pet.currency] >= pet.cost;
            const isActive = state.pet.id === pet.id;
            
            return `
                <div class="shop-item ${owned ? 'owned' : ''} ${!canAfford && !owned ? 'disabled' : ''}" 
                     onclick="${owned ? `changePet('${pet.id}')` : `buyPet('${pet.id}')`}">
                    <div class="shop-item-icon" style="background: ${pet.color}20; color: ${pet.color}; font-size: 2.5rem;">
                        ${pet.icon}
                    </div>
                    <div class="shop-item-name">${pet.name}</div>
                    <div class="shop-item-price">
                        ${isActive ? 'ACTIVE' : owned ? 'OWNED' : pet.cost === 0 ? 'FREE' : `<i class="fas fa-${pet.currency === 'gems' ? 'gem' : 'coins'}"></i> ${pet.cost}`}
                    </div>
                </div>
            `;
        }).join('');
    } else if (tab === 'boosts') {
        const boosts = SHOP_ITEMS.filter(i => i.type === 'boost');
        grid.innerHTML = boosts.map(item => {
            const canAfford = state[item.currency] >= item.cost;
            
            return `
                <div class="shop-item ${!canAfford ? 'disabled' : ''}" 
                     onclick="${canAfford ? `buyItem('${item.id}')` : ''}">
                    <div class="shop-item-icon" style="background: ${item.color}20; color: ${item.color};">
                        ${item.icon}
                    </div>
                    <div class="shop-item-name">${item.name}</div>
                    <div class="shop-item-price">
                        <i class="fas fa-${item.currency === 'gems' ? 'gem' : 'coins'}"></i> ${item.cost}
                    </div>
                </div>
            `;
        }).join('');
    }
}

function buyItem(id) {
    const item = SHOP_ITEMS.find(i => i.id === id);
    if (state[item.currency] < item.cost) {
        showToast(`Not enough ${item.currency}!`, 'error');
        return;
    }
    
    if (item.type === 'boost') {
        state[item.currency] -= item.cost;
        activateBoost(id);
        closeShop();
        return;
    }
    
    state[item.currency] -= item.cost;
    state.inventory.push(id);
    
    if (item.type === 'theme') {
        applyTheme(item.id.split('_')[1]);
    }
    
    saveState();
    updateUI();
    switchShopTab(currentShopTab);
    showToast('Item purchased!', 'success');
}

function buyPet(petId) {
    const pet = PETS.find(p => p.id === petId);
    if (state[pet.currency] < pet.cost) {
        showToast(`Not enough ${pet.currency}!`, 'error');
        return;
    }
    
    state[pet.currency] -= pet.cost;
    state.inventory.push(`pet_${petId}`);
    
    saveState();
    updateUI();
    switchShopTab('pets');
    showToast('Pet purchased!', 'success');
}

function closeShop() {
    document.getElementById('shopModal').classList.remove('active');
}

// --- RENDERING ---

function renderAll() {
    renderJourneyMap();
    renderMission();
    renderHabits();
    renderLeaderboard();
    renderAchievements();
    updateChart();
}

function renderJourneyMap() {
    const journey = JOURNEYS[state.currentJourney];
    const progress = state.journeyProgress[state.currentJourney] || { currentStage: 0, dayInStage: 0 };
    const container = document.getElementById('journeyMap');
    
    const icons = ['fa-seedling', 'fa-fire', 'fa-mountain', 'fa-crown'];
    const pct = ((progress.currentStage * 7 + progress.dayInStage) / (journey.stages.length * 7)) * 100;
    
    container.innerHTML = `
        <div class="path-line">
            <div class="path-progress" style="width: ${pct}%"></div>
        </div>
        ${journey.stages.map((stage, i) => {
            let status = 'locked';
            if (i < progress.currentStage) status = 'completed';
            if (i === progress.currentStage) status = 'current';
            
            return `
                <div class="map-node ${status}">
                    <div class="node-orb">
                        <i class="fas ${icons[i]}"></i>
                    </div>
                    <div class="node-label">${stage.name}</div>
                </div>
            `;
        }).join('')}
    `;
}

function renderMission() {
    const journey = JOURNEYS[state.currentJourney];
    let progress = state.journeyProgress[state.currentJourney];
    
    if (!progress) {
        progress = { currentStage: 0, dayInStage: 0, tasks: {} };
        state.journeyProgress[state.currentJourney] = progress;
    }
    
    if (progress.currentStage >= journey.stages.length) {
        document.getElementById('missionSection').innerHTML = `
            <div class="mission-card" style="text-align: center;">
                <i class="fas fa-trophy" style="font-size: 3rem; color: var(--accent); margin-bottom: 15px;"></i>
                <h3>Journey Complete!</h3>
                <p>You've mastered ${journey.name}</p>
            </div>
        `;
        return;
    }
    
    const stage = journey.stages[progress.currentStage];
    const completedTasks = Object.keys(progress.tasks || {}).filter(k => k.startsWith(`${progress.currentStage}-`)).length;
    const pct = (completedTasks / stage.habits.length) * 100;
    
    document.getElementById('missionCard').innerHTML = `
        <div class="mission-header">
            <div class="mission-icon" style="background: ${journey.color};">
                <i class="fas ${journey.icon}"></i>
            </div>
            <div class="mission-info">
                <h3>${stage.name}</h3>
                <p>Day ${progress.dayInStage + 1}/7 • Stage ${progress.currentStage + 1} of ${journey.stages.length}</p>
            </div>
        </div>
        <div class="mission-progress">
            <div class="mission-progress-bar">
                <div class="mission-progress-fill" style="width: ${pct}%"></div>
            </div>
            <div class="mission-progress-text">${completedTasks}/${stage.habits.length}</div>
        </div>
        <div class="mission-tasks">
            ${stage.habits.map((task, i) => {
                const key = `${progress.currentStage}-${i}`;
                const done = progress.tasks && progress.tasks[key];
                return `
                    <div class="mission-task ${done ? 'completed' : ''}" onclick="toggleMissionTask(${progress.currentStage}, ${i})">
                        <div class="task-check"><i class="fas fa-check"></i></div>
                        <div class="task-text">${task}</div>
                        <div class="task-reward"><i class="fas fa-star"></i> +15</div>
                    </div>
                `;
            }).join('')}
        </div>
    `;
}

function toggleMissionTask(stageIdx, taskIdx) {
    if (!state.journeyProgress[state.currentJourney]) {
        state.journeyProgress[state.currentJourney] = { currentStage: 0, dayInStage: 0, tasks: {} };
    }
    
    const progress = state.journeyProgress[state.currentJourney];
    if (progress.currentStage !== stageIdx) return;
    
    const key = `${stageIdx}-${taskIdx}`;
    const isDone = progress.tasks[key];
    
    if (isDone) {
        delete progress.tasks[key];
    } else {
        progress.tasks[key] = true;
        addXP(15);
        state.coins += 8;
        showFloatingText(event, '+15 XP +8🪙');
        
        const journey = JOURNEYS[state.currentJourney];
        const stage = journey.stages[stageIdx];
        const completed = Object.keys(progress.tasks).filter(k => k.startsWith(`${stageIdx}-`)).length;
        
        if (completed >= stage.habits.length) {
            setTimeout(() => {
                addXP(stage.xp);
                state.coins += 50;
                progress.dayInStage++;
                
                if (progress.dayInStage >= 7) {
                    progress.currentStage++;
                    progress.dayInStage = 0;
                    progress.tasks = {};
                    showResult('Stage Complete!', `+${stage.xp} XP Bonus!`, '🎉', 'Continue');
                } else {
                    progress.tasks = {};
                    showToast(`Day ${progress.dayInStage}/7 complete!`, 'success');
                }
                
                checkAchievement('complete_journey');
                renderAll();
            }, 500);
        }
    }
    
    saveState();
    renderMission();
    updateUI();
}

function renderHabits() {
    const container = document.getElementById('habitsList');
    const today = new Date().toDateString();
    const comps = state.completions[today] || {};
    
    if (state.habits.length === 0) {
        container.innerHTML = `
            <div class="empty-state">
                <i class="fas fa-scroll"></i>
                <p>No active quests. Create one!</p>
            </div>
        `;
        return;
    }
    
    container.innerHTML = state.habits.map(h => {
        const done = comps[h.id];
        const chain = Array(7).fill(0).map((_, i) => {
            const d = new Date();
            d.setDate(d.getDate() - (6 - i));
            return state.completions[d.toDateString()]?.[h.id];
        });
        
        return `
            <div class="habit-card ${done ? 'completed' : ''}" onclick="toggleHabit(${h.id})">
                <div class="habit-icon-wrapper">
                    <div class="habit-icon">
                        <i class="fas ${h.icon}"></i>
                    </div>
                    ${h.streak > 2 ? `<div class="habit-streak-badge"><i class="fas fa-fire"></i></div>` : ''}
                </div>
                <div class="habit-info">
                    <div class="habit-title">
                        ${h.name}
                        ${done ? '<i class="fas fa-check-circle" style="color: var(--accent);"></i>' : ''}
                    </div>
                    <div class="habit-chain">
                        ${chain.map(c => `<div class="chain-link ${c ? 'active' : ''}"></div>`).join('')}
                    </div>
                    <div class="habit-meta">
                        <span>Best: ${h.streak} days</span>
                        <span class="habit-reward"><i class="fas fa-bolt"></i> 5 | <i class="fas fa-coins"></i> 10</span>
                    </div>
                </div>
                <div class="habit-check">
                    <i class="fas fa-check"></i>
                </div>
            </div>
        `;
    }).join('');
}

function renderLeaderboard() {
    const list = document.getElementById('leaderboardList');
    LEADERBOARD[4].score = state.totalXP;
    LEADERBOARD[4].level = state.level;
    
    const sorted = [...LEADERBOARD].sort((a, b) => b.score - a.score);
    
    list.innerHTML = sorted.map((user, i) => `
        <div class="leaderboard-item" style="${user.isUser ? 'background: var(--primary-soft); border-color: var(--primary);' : ''}">
            <div class="leaderboard-rank ${i < 3 ? ['gold', 'silver', 'bronze'][i] : ''}">${i + 1}</div>
            <div class="leaderboard-avatar">${user.avatar}</div>
            <div class="leaderboard-info">
                <div class="leaderboard-name">${user.name} ${user.isUser ? '(You)' : ''}</div>
                <div class="leaderboard-level">Level ${user.level}</div>
            </div>
            <div class="leaderboard-score">${user.score.toLocaleString()}</div>
        </div>
    `).join('');
}

function renderAchievements() {
    const achievements = [
        { id: 'first_habit', name: 'First Steps', desc: 'Create your first habit', icon: 'fa-shoe-prints' },
        { id: 'week_streak', name: 'On Fire', desc: '7 day streak', icon: 'fa-fire' },
        { id: 'level_5', name: 'Rising Star', desc: 'Reach level 5', icon: 'fa-star' },
        { id: 'complete_journey', name: 'Path Walker', desc: 'Complete a journey stage', icon: 'fa-road' },
        { id: 'rich', name: 'Treasure Hunter', desc: 'Collect 500 coins', icon: 'fa-coins' },
        { id: 'master', name: 'Habit Master', desc: 'Complete a habit 30 times', icon: 'fa-crown' }
    ];
    
    document.getElementById('achievementsList').innerHTML = achievements.map(a => {
        const unlocked = state.achievements.includes(a.id);
        return `
            <div class="achievement-item ${unlocked ? 'unlocked' : ''}">
                <div class="achievement-icon">
                    <i class="fas ${a.icon}"></i>
                </div>
                <div class="achievement-info">
                    <div class="achievement-name">${a.name}</div>
                    <div class="achievement-desc">${a.desc}</div>
                </div>
                <div class="achievement-status">
                    <i class="fas ${unlocked ? 'fa-check-circle' : 'fa-lock'}"></i>
                </div>
            </div>
        `;
    }).join('');
}

function updateChart() {
    const ctx = document.getElementById('analyticsChart');
    if (!ctx) return;
    
    const days = document.querySelector('.chart-tab.active').textContent.includes('7') ? 7 : 30;
    const labels = [];
    const data = [];
    
    for (let i = days - 1; i >= 0; i--) {
        const d = new Date();
        d.setDate(d.getDate() - i);
        labels.push(i === 0 ? 'Today' : d.toLocaleDateString('en', { weekday: 'short' }));
        data.push(Object.keys(state.completions[d.toDateString()] || {}).length);
    }
    
    if (chartInstance) chartInstance.destroy();
    
    const primary = getComputedStyle(document.body).getPropertyValue('--primary').trim();
    
    chartInstance = new Chart(ctx, {
        type: 'line',
        data: {
            labels,
            datasets: [{
                data,
                borderColor: primary,
                backgroundColor: primary + '20',
                fill: true,
                tension: 0.4,
                pointRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { stepSize: 1 } }
            }
        }
    });
}

// --- UI UPDATES ---

function updateUI() {
    const needed = getXPForLevel(state.level);
    const xpPct = (state.xp / needed) * 100;
    
    document.getElementById('xpBar').style.width = `${xpPct}%`;
    document.getElementById('currentXP').textContent = state.xp;
    document.getElementById('maxXP').textContent = needed;
    document.getElementById('currentLevel').textContent = state.level;
    document.getElementById('headerLevel').textContent = state.level;
    
    document.getElementById('statCoins').textContent = state.coins;
    document.getElementById('statGems').textContent = state.gems;
    document.getElementById('statEnergy').textContent = state.energy;
    document.getElementById('energyBar').style.width = `${(state.energy / state.maxEnergy) * 100}%`;
    document.getElementById('energyText').textContent = `${state.energy}/${state.maxEnergy}`;
    
    // Pet UI
    const pet = PETS.find(p => p.id === state.pet.id) || PETS[0];
    document.getElementById('petAvatar').textContent = pet.icon;
    document.getElementById('petName').innerHTML = `${state.pet.name} <span class="pet-level">Lvl ${state.pet.level}</span>`;
    document.getElementById('petLevel').textContent = state.pet.level;
    document.getElementById('petHappiness').textContent = state.pet.happiness;
    document.getElementById('petHunger').textContent = state.pet.hunger;
    document.getElementById('petHappinessBar').style.width = `${state.pet.happiness}%`;
    document.getElementById('petHungerBar').style.width = `${state.pet.hunger}%`;
    
    document.getElementById('statStreak').textContent = state.streak;
    document.getElementById('statCompleted').textContent = Object.keys(state.completions[new Date().toDateString()] || {}).length;
    document.getElementById('statBest').textContent = state.bestStreak;
    document.getElementById('statTotal').textContent = state.totalXP;
    
    document.getElementById('profileLevel').textContent = state.level;
    document.getElementById('profileRank').textContent = ['Novice', 'Apprentice', 'Warrior', 'Knight', 'Champion', 'Master', 'Legend'][Math.min(state.level - 1, 6)] || 'God';
    document.getElementById('profileHabits').textContent = state.habits.length;
    document.getElementById('profileCompleted').textContent = state.habits.reduce((a, h) => a + h.total, 0);
    document.getElementById('profileCoins').textContent = state.coins;
}

function startEnergyRegen() {
    setInterval(() => {
        if (state.energy < state.maxEnergy) {
            state.energy = Math.min(state.maxEnergy, state.energy + 1);
            updateUI();
            saveState();
        }
    }, 60000);
}

// --- UTILITIES ---

function switchView(view) {
    document.querySelectorAll('[id^="view-"]').forEach(el => el.classList.add('hidden'));
    document.getElementById(`view-${view}`).classList.remove('hidden');
    
    document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
    event.currentTarget.classList.add('active');
    
    if (view === 'social') renderLeaderboard();
    if (view === 'profile') renderAchievements();
}

function toggleTheme() {
    const themes = ['light', 'dark', 'forest'];
    const current = state.theme || 'light';
    const next = themes[(themes.indexOf(current) + 1) % themes.length];
    applyTheme(next);
}

function applyTheme(theme) {
    if (!theme) theme = state.theme || 'light';
    state.theme = theme;
    document.body.setAttribute('data-theme', theme);
    document.getElementById('themeIcon').className = `fas fa-${theme === 'light' ? 'moon' : 'sun'}`;
    saveState();
    updateChart();
}

function showToast(msg, type = 'info') {
    const container = document.getElementById('toastContainer');
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    
    const icons = { success: 'fa-check', error: 'fa-exclamation', info: 'fa-info', warning: 'fa-exclamation-triangle' };
    toast.innerHTML = `<i class="fas ${icons[type]} toast-icon"></i> <span>${msg}</span>`;
    
    container.appendChild(toast);
    setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
    }, 3000);
}

function showFloatingText(e, text) {
    const el = document.createElement('div');
    el.className = 'float-text';
    el.textContent = text;
    el.style.left = (e.clientX - 30) + 'px';
    el.style.top = (e.clientY - 40) + 'px';
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 1000);
}

function showResult(title, subtitle, icon, btnText) {
    document.getElementById('resultTitle').textContent = title;
    document.getElementById('resultAmount').textContent = subtitle;
    document.getElementById('resultIcon').innerHTML = icon;
    document.querySelector('.result-btn').textContent = btnText;
    document.getElementById('resultOverlay').classList.add('active');
}

function closeResult() {
    document.getElementById('resultOverlay').classList.remove('active');
}

function createConfetti(count = 30) {
    const colors = ['#f43f5e', '#8b5cf6', '#0ea5e9', '#10b981', '#f59e0b'];
    for (let i = 0; i < count; i++) {
        const c = document.createElement('div');
        c.className = 'confetti';
        c.style.left = Math.random() * 100 + 'vw';
        c.style.background = colors[Math.floor(Math.random() * colors.length)];
        c.style.animation = `confetti-fall ${2 + Math.random() * 2}s linear forwards`;
        c.style.animationDelay = Math.random() * 0.5 + 's';
        document.body.appendChild(c);
        setTimeout(() => c.remove(), 4000);
    }
}

function checkAchievement(id) {
    if (!state.achievements.includes(id)) {
        state.achievements.push(id);
        const names = { first_habit: 'First Steps', week_streak: 'On Fire', level_5: 'Rising Star', complete_journey: 'Path Walker' };
        showToast(`Achievement: ${names[id] || id}! +5💎`, 'success');
        state.gems += 5;
        saveState();
        renderAchievements();
    }
}

function switchChart(range) {
    document.querySelectorAll('.chart-tab').forEach(t => t.classList.remove('active'));
    event.target.classList.add('active');
    updateChart();
}

// --- MODAL CONTROLS ---

function openAddModal() {
    document.getElementById('addModal').classList.add('active');
    document.getElementById('habitNameInput').value = '';
}

function closeAddModal() {
    document.getElementById('addModal').classList.remove('active');
}

function quickAdd() {
    openAddModal();
}

function showJourneyInfo() {
    showToast('Complete all 7 days to advance to the next stage!', 'info');
}

// --- PERSISTENCE ---

function saveState() {
    localStorage.setItem('habitQuest_v5', JSON.stringify(state));
}

function loadState() {
    const saved = localStorage.getItem('habitQuest_v5');
    if (saved) {
        const parsed = JSON.parse(saved);
        Object.assign(state, parsed);
    }
}

// Close modals on outside click
document.querySelectorAll('.modal-overlay').forEach(m => {
    m.addEventListener('click', (e) => {
        if (e.target === m && !m.id.includes('result')) m.classList.remove('active');
    });
});
</script>

